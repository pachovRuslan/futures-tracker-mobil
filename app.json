{
  "expo": {
    "name": "Futures Tracker",
    "slug": "futures-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "futurestracker",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0d12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.futurestracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0d12"
      },
      "package": "com.yourname.futurestracker"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    }
  }
}
