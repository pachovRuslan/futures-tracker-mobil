# Supabase (обязательно для запуска): https://<ref>.supabase.co и anon key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# REST-бэкенд сайта (подключения бирж, sync-entitlement Premium)
EXPO_PUBLIC_API_URL=https://futures-tracker-lake.vercel.app
# RevenueCat — биллинг Premium. Публичные SDK-ключи из RC Dashboard →
# Project Settings → API Keys. Пока пусты — пейволл показывает заглушку
# «Покупка недоступна» (kill-switch), остальное приложение работает.
# Настройка RC/Google Play и тест-план покупок: docs/BILLING.md
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
